# Database
DATABASE_URL=postgres://aws_billing:changeme@192.168.128.9:5432/aws_billing

# Keycloak OIDC
KEYCLOAK_DISCOVERY_URL=https://kc.mees.st/realms/REALM/.well-known/openid-configuration
KEYCLOAK_CLIENT_ID=aws-billing
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_VIEWER_GROUP=aws-billing-viewers
KEYCLOAK_ADMIN_GROUP=aws-billing-admins

# Session cookie signing key (generate with: openssl rand -hex 32)
SESSION_SECRET=changeme

# AWS Cost Explorer profiles (in mounted ~/.aws/credentials)
AWS_PROFILE_ORG=org
AWS_PROFILE_SEPARATE=tony

# Auth bypass for local development (NEVER set true in production)
AUTH_ENABLED=true
DEV_USER_EMAIL=dev@local
DEV_USER_NAME=Dev User
DEV_USER_IS_ADMIN=true

# Optional: ping a healthcheck after sync
HEALTHCHECK_URL=
